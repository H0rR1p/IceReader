BINGDU_CLOUD_PUBLIC_URL=https://cloud.example.com
BINGDU_CLOUD_SECRET=replace-with-at-least-32-random-bytes
BINGDU_CLOUD_DEV_MODE=0
BINGDU_CLOUD_ALLOWED_ORIGINS=
BINGDU_CLOUD_DATABASE=/app/data/cloud/cloud.sqlite3

# SMTP is required in production for verification and password recovery.
BINGDU_SMTP_HOST=smtp.example.com
BINGDU_SMTP_PORT=587
BINGDU_SMTP_USERNAME=
BINGDU_SMTP_PASSWORD=
BINGDU_SMTP_FROM=冰读 <noreply@example.com>
BINGDU_SMTP_STARTTLS=1

# Generic OIDC providers. Register the callback URL
# https://cloud.example.com/v1/auth/oidc/callback/<provider-id>
BINGDU_CLOUD_OIDC_PROVIDERS=[{"id":"google","label":"Google","kind":"oidc","discovery_url":"https://accounts.google.com/.well-known/openid-configuration","client_id":"","client_secret":"","scopes":["openid","email","profile"]}]

# Optional GitHub OAuth login.
BINGDU_GITHUB_CLIENT_ID=
BINGDU_GITHUB_CLIENT_SECRET=

