{
  "name": "jap-study-reader",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build_android.ps1",
    "android:sync": "npm run build && cap sync android",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop:dev": "npm run build && electron .",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build_desktop.ps1",
    "desktop:test": "node scripts/test_desktop.cjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/app": "8.0.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/share": "8.0.1",
    "@vitejs/plugin-react": "latest",
    "dexie": "latest",
    "jszip": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "42.4.0",
    "electron-builder": "26.0.12",
    "playwright": "1.58.2",
    "resedit": "1.7.2",
    "typescript": "latest",
    "vite": "latest"
  },
  "main": "desktop/main.cjs",
  "description": "冰读日语学习阅读客户端",
  "author": "IceReader contributors",
  "license": "AGPL-3.0-or-later"
}
