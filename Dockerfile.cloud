FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY backend/requirements.txt backend/requirements-cloud.txt /app/backend/
RUN pip install --no-cache-dir -r /app/backend/requirements-cloud.txt
COPY backend /app/backend
RUN mkdir -p /app/data/cloud
EXPOSE 8010
CMD ["python", "-m", "uvicorn", "backend.cloud_app:app", "--host", "0.0.0.0", "--port", "8010", "--proxy-headers", "--forwarded-allow-ips", "*"]

